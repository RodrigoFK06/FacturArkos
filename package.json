{
  "name": "facturarkos",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @facturarkos/api start:dev",
    "dev:web": "pnpm --filter @facturarkos/web dev",
    "build": "pnpm -r build",
    "prisma:generate": "pnpm --filter @facturarkos/api prisma:generate",
    "prisma:migrate": "pnpm --filter @facturarkos/api prisma:migrate",
    "prisma:push": "pnpm --filter @facturarkos/api prisma:push",
    "seed": "pnpm --filter @facturarkos/api seed",
    "typecheck": "pnpm -r typecheck"
  }
}
