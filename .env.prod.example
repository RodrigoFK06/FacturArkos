# FacturArkos — variables de producción (para docker-compose.prod.yml). Copiar a .env
# Genera secretos con: openssl rand -hex 32

DB_PASSWORD=cambia-esta-clave-de-postgres
JWT_SECRET=                      # openssl rand -hex 32
SECRETS_ENCRYPTION_KEY=         # openssl rand -hex 32 (32 bytes exactos)

# URLs públicas (para CORS y para hornear la URL del API en el frontend)
WEB_PUBLIC_URL=https://app.tudominio.com
API_PUBLIC_URL=https://api.tudominio.com/api

# APISUNAT — credenciales seed de dev (en prod cada tenant trae las suyas vía /sunat-config)
APISUNAT_PERSONA_ID=
APISUNAT_TOKEN=
APISUNAT_TEST_MODE=true

# Consulta DNI/RUC (apis.net.pe)
PERU_API_TOKEN=
