# ─────────────────────────────────────────────────────────────
# FacturArkos API — variables de entorno
# Copiar a .env y completar. Valores dev tomados del PLAYBOOK §7.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3001
# Orígenes permitidos para CORS (coma-separados)
CORS_ORIGINS=http://localhost:3000

# Base de datos
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/facturarkos?schema=public"

# Auth
JWT_SECRET="cambia-esto-por-uno-largo-y-aleatorio"
JWT_EXPIRES_IN="12h"

# Cifrado de secrets de terceros at-rest (P1). Generar: openssl rand -hex 32
SECRETS_ENCRYPTION_KEY="efb1bf3af71f29a56e02707b7f982cedc6724633f3d715fd2e99ea8708b17d03"

# APISUNAT — fallback/seed de DEV (cuenta "arkosprueba"). En producción cada
# tenant trae sus credenciales cifradas en la tabla sunat_configs.
APISUNAT_BASE_URL="https://back.apisunat.com"
APISUNAT_PERSONA_ID="69fb5c4e003caf0029394d5f"
APISUNAT_TOKEN="DEV_evOeUPMtbmiGp0gfCfzW4HF6BwvmKx7IlDcQgD11pIGd8aCUuQCBhNhrhZOi8yfC"
APISUNAT_TEST_MODE="true"

# Consulta DNI/RUC (apiperu.dev). Vacío en dev.
PERU_API_TOKEN=""
PERU_API_BASE_URL="https://api.apis.net.pe"

# Niubiz QR — credenciales SANDBOX públicas (playbook §7). Per-tenant en prod.
NIUBIZ_ENV="sandbox"
NIUBIZ_SECURITY_URL="https://apitestenv.vnforapps.com"
NIUBIZ_QR_URL="https://apitestenv.vnforapps.com"
# Secreto del webhook (header x-niubiz-webhook-secret). Generar: openssl rand -hex 32
NIUBIZ_WEBHOOK_SECRET=""
